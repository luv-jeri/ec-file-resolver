{
  "name": "ec-file-resolver",
  "version": "1.0.0",
  "description": "Local file path resolver for browser-based uploads",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "package:mac": "pnpm run build && electron-builder --mac",
    "package:win": "pnpm run build && electron-builder --win"
  },
  "author": "Evolphin Software",
  "license": "UNLICENSED",
  "private": true,
  "devDependencies": {
    "@types/auto-launch": "^5.0.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "electron": "^40.6.1",
    "electron-builder": "^26.8.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-electron": "^0.29.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "auto-launch": "^5.0.6",
    "cors": "^2.8.6",
    "express": "^5.2.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "electron-winstaller"
    ]
  }
